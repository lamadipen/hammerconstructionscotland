---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import SectionHead from '../../components/SectionHead.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import Process from '../../components/Process.astro';
import ContactBlock from '../../components/ContactBlock.astro';
import { home, services } from '../../lib/content';
---
<Base title="Our services" description={home.services.text}>
  <PageHero
    eyebrow={home.services.eyebrow}
    title={home.services.title}
    text={home.services.text}
    image={services[0]?.image.replace('w=1200', 'w=2000')}
    crumbs={[{ label: 'Services' }]}
  />
  <section>
    <div class="wrap">
      <div class="services">
        {services.map((s, i) => <ServiceCard service={s} index={i} />)}
      </div>
    </div>
  </section>
  <Process />
  <ContactBlock />
</Base>
